# Cloud LLM (used by the "remote" provider backend and the default Pro-mode composer)
ANTHROPIC_API_KEY=

# Cloud STT provider (optional alternative to the local MLX Whisper path)
DEEPGRAM_API_KEY=

# Set to 1 to run the LLM layer against a canned/fake response (useful for
# local development without burning API credits)
MC_LLM_FAKE=0
